# docker-compose.prod.yml + EC2 배포용 예시. 복사: cp .env.production.example .env.production

# ---- 프론트 빌드 (nginx가 브라우저에 주입될 API 루트, /api 접미사 포함)
# 운영 API가 바뀌면 여기와 프론트 이미지 재빌드 필요 (VITE는 빌드 시 박힘)
VITE_API_BASE_URL=https://sbc365.co.kr/api

# ---- compose 포트 (호스트)
API_PORT=3000
WEB_PORT=80

# ---- 백엔드 (backend/server.js / mysql / openai / s3)
# DB_HOST=
# DB_USER=
# DB_PASS=
# DB_NAME=
# OPENAI_API_KEY=
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_KEY_PREFIX=applications
# USE_BLOCK_PIPELINE=0
